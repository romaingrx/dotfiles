{
  "id": "root",
  "type": "row",
  "titlebar": "none",
  "traffic_lights": [12, 16],
  "background": "canvas",
  "terminal_padding": [14, 12],
  "divider": { "width": 1, "color": "border" },
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "size": { "px": 250 },
      "min": 180,
      "max": 420,
      "background": "chrome",
      "resizable": false,
      "children": [
        {
          "id": "sidebar-top",
          "type": "block",
          "size": { "px": 46 },
          "window_drag": true,
          "content": { "mod": "projects", "props": { "part": "top" } }
        },
        {
          "id": "projects",
          "type": "block",
          "content": { "mod": "projects", "props": { "part": "projects" } }
        }
      ]
    },
    {
      "id": "work",
      "type": "column",
      "size": { "weight": 3 },
      "resizable": false,
      "children": [
        {
          "id": "main",
          "type": "block",
          "padding": 8,
          "content": {
            "tab": "active",
            "pane": {
              "gap": 8,
              "radius": 10,
              "background": "background",
              "lone": true,
              "border": { "width": 1, "color": "border" },
              "focus": { "width": 1, "color": "accent" }
            }
          }
        },
        {
          "id": "status",
          "type": "block",
          "size": { "px": 28 },
          "content": { "mod": "workspace-status" }
        }
      ]
    },
    {
      "id": "panel",
      "type": "column",
      "size": { "weight": 2 },
      "min": 300,
      "background": "chrome",
      "resizable": false,
      "children": [
        {
          "id": "panel-tabs",
          "type": "block",
          "size": { "px": 40 },
          "content": { "mod": "projects", "props": { "part": "tabs" } }
        },
        {
          "id": "panel-body",
          "type": "stack",
          "active": "threads",
          "children": [
            {
              "id": "threads",
              "type": "block",
              "content": { "mod": "projects", "props": { "part": "threads" } }
            },
            { "id": "files", "type": "block", "content": { "mod": "files" } },
            { "id": "changes", "type": "block", "content": { "mod": "changes" } }
          ]
        }
      ]
    }
  ]
}
