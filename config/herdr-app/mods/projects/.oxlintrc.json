{
  "plugins": ["typescript", "unicorn", "oxc"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "eslint/complexity": ["warn", { "max": 10 }],
    "typescript/no-explicit-any": "error",
    "typescript/no-non-null-assertion": "error"
  },
  "overrides": [
    {
      "files": ["**/*.test.ts"],
      "rules": {
        "eslint/complexity": "off"
      }
    }
  ],
  "ignorePatterns": ["main.js", "gpui-kit.d.ts"]
}
