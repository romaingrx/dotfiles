{
  "reload_style_on_change": true,
  "layer": "top",
  "position": "top",
  "spacing": 0,
  "height": 26,
  "modules-left": [
    "hyprland/workspaces"
  ],
  "modules-center": [
    "clock"
  ],
  // Graphs and Tailscale come from scripts that modules/home/programs/waybar.nix
  // builds from lib/theme; it also sets their `exec`.
  "modules-right": [
    "custom/network",
    "image#tailscale",
    "custom/memory",
    "custom/cpu"
  ],
  "hyprland/workspaces": {
    "on-click": "activate",
    // The number, then an icon per open window. The active one is accented in
    // style.css.
    "format": "{name}{windows}",
    "format-window-separator": "",
    "window-rewrite-default": " 󰣆",
    "window-rewrite": {
      "class<Alacritty|kitty|com.mitchellh.ghostty>": " 󰆍",
      "class<firefox>": " 󰈹",
      "class<[Ss]potify>": " 󰓇",
      "class<signal>": " 󰭹",
      "class<obsidian>": " ",
      "class<thunderbird>": " 󰇮",
      "class<[Ss]lack>": " 󰒱",
      "class<1[Pp]assword>": " 󰌆",
      "class<org.gnome.Nautilus>": " 󰉋"
    },
    "persistent-workspaces": {
      "1": [],
      "2": [],
      "3": [],
      "4": [],
      "5": []
    }
  },
  "clock": {
    "interval": 1,
    "format": "{:L%H:%M:%S}",
    "format-alt": "{:L%d %B W%V %Y}",
    "tooltip": true,
    "tooltip-format": "<tt>{calendar}</tt>",
    "calendar": {
      "mode": "month",
      "mode-mon-col": 3,
      "on-scroll": 1,
      "on-click-right": "mode"
    }
  },
  "custom/network": {
    "return-type": "json",
    "tooltip": true
  },
  "image#tailscale": {
    "size": 13,
    "interval": 10,
    "tooltip": true
  },
  "custom/memory": {
    "return-type": "json",
    "tooltip": true,
    "on-click": "uwsm app -- $TERMINAL -e btop"
  },
  "custom/cpu": {
    "return-type": "json",
    "tooltip": true,
    "on-click": "uwsm app -- $TERMINAL -e btop"
  }
}
