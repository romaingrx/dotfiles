#!/usr/bin/env bash

if [ -z "${CONFIG_DIR:-}" ] || [ ! -r "$CONFIG_DIR/colors.sh" ]; then
	CONFIG_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
fi
PLUGIN_DIR="$CONFIG_DIR/plugins"
ITEM_DIR="$CONFIG_DIR/items"
HELPER_DIR="$CONFIG_DIR/helpers"

source "$CONFIG_DIR/colors.sh" || exit 1
source "$CONFIG_DIR/icons.sh"

# Fonts and STATUS_* sizes, shared with the plugins.
source "$HELPER_DIR/env.sh"
sketchybar_resolve_paths "$HELPER_DIR"
export ITEM_DIR

if [ -n "${SKETCHYBAR_APP_FONT_PATH:-}" ] && [ -r "$SKETCHYBAR_APP_FONT_PATH" ]; then
	sketchybar --load-font "$SKETCHYBAR_APP_FONT_PATH"
fi

sketchybar --bar height=30 \
	blur_radius=30 \
	position=top \
	padding_left=12 \
	padding_right=12 \
	color="$BAR_BG" \
	shadow=off

sketchybar --default updates=when_shown \
	drawing=on \
	icon.font="$NERD_FONT:Regular:14.0" \
	icon.color="$DEFAULT_ICON_COLOR" \
	label.font="$FONT:Medium:14.0" \
	label.color="$DEFAULT_LABEL_COLOR" \
	label.padding_left=4 \
	label.padding_right=4 \
	icon.padding_left=4 \
	icon.padding_right=4 \
	icon.shadow.drawing=on \
	icon.shadow.color="$TEXT_SHADOW" \
	icon.shadow.distance=1 \
	label.shadow.drawing=on \
	label.shadow.color="$TEXT_SHADOW" \
	label.shadow.distance=1 \
	popup.background.color="$POPUP_BG" \
	popup.background.border_color="$THEME_SURFACE" \
	popup.background.border_width=1 \
	popup.background.corner_radius=8 \
	popup.blur_radius=50 \
	popup.height=26

source $ITEM_DIR/display_recovery.sh
source $ITEM_DIR/spaces.sh
source $ITEM_DIR/mode.sh
source $ITEM_DIR/window_title.sh
source $ITEM_DIR/clock.sh
source $ITEM_DIR/battery.sh
source $ITEM_DIR/stats.sh
source $ITEM_DIR/wifi.sh

sketchybar --update

echo "sketchybar configuration loaded.."
